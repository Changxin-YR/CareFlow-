# ============================================================
# CareFlow 康脉智护 AI Gateway —— 环境变量模板
# 复制为 .env 后填写。**禁止把真实密钥提交到版本库。**
# ============================================================

APP_ENV=development

# AI 提供方：mock（本地/离线，默认）| qianfan（运行时正式使用百度千帆）
AI_PROVIDER=qianfan

# ---------------- 百度千帆 / AppBuilder ----------------
QIANFAN_API_KEY=
QIANFAN_APP_ID=
QIANFAN_MODEL=ernie-4.0-turbo-8k
QIANFAN_BASE_URL=https://qianfan.baidubce.com
# 认证模式：bearer（v2 OpenAI 兼容，默认）| oauth（旧网关 AK/SK 换 token）
QIANFAN_AUTH_MODE=bearer
QIANFAN_EMBEDDING_MODEL=bge-large-zh
QIANFAN_OAUTH_URL=https://aip.baidubce.com/oauth/2.0/token

# 千帆知识库 ID（按域划分；留空则该域退化为本地切片检索）
QIANFAN_KB_CORE_ID=
QIANFAN_KB_HTN_ID=
QIANFAN_KB_DM_ID=
QIANFAN_KB_COPD_ID=
QIANFAN_KB_MULTIMORBIDITY_ID=
QIANFAN_KB_LIFESTYLE_ID=
QIANFAN_KB_PRIMARYCARE_ID=
QIANFAN_KB_WHO_ID=

# ---------------- RAG ----------------
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_SCORE_THRESHOLD=0.0
RAG_ENABLE_LLM_ROUTER=true

# 相关性闸门（按当前语料经验标定：1099→1041 个切片、平均约 597 字符）
# 命中词数低于 RAG_MIN_MATCHED_TERMS 且 BM25 分低于 RAG_MIN_RELEVANCE_SCORE 时，
# 判定为"无证据"，返回 insufficient_evidence=true 而不是拿弱命中硬答。
# ⚠️ 换语料或大幅增删文档后必须重新标定，否则会出现"该答不答"或"不该答乱答"。
RAG_MIN_MATCHED_TERMS=3
RAG_MIN_RELEVANCE_SCORE=12.0

# ---------------- HTTP 客户端 ----------------
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=1

# ---------------- 服务 ----------------
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO
